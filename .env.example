# ─────────────────────────────────────────────
# NoteFlow — variables de entorno (EJEMPLO)
# 1. Copia este archivo y renómbralo a ".env"
# 2. Llena los valores reales en ".env"
# 3. NUNCA subas ".env" a GitHub (ya está en .gitignore)
# ─────────────────────────────────────────────

# Puerto donde corre el servidor (Render/Vercel ponen PORT solos)
PUERTO=3000

# ── Base de datos: Neon (PostgreSQL) ──
# Neon > tu proyecto > botón "Connect" > copia la "connection string".
# Si la dejas vacía, NoteFlow funciona en MODO LOCAL (datos en el navegador).
DATABASE_URL=

# ── Correo para enviar el código de acceso ──
# Recomendado para hosting: HTTPS con Resend (no requiere SMTP saliente).
# Crea una API key en https://resend.com/api-keys.
# El remitente debe ser onboarding@resend.dev para pruebas a tu propia
# dirección de Resend, o una dirección de un dominio verificado.
RESEND_API_KEY=
# Ejemplo tras verificar tu dominio: NoteFlow <acceso@tu-dominio.com>
CORREO_REMITENTE=

# Alternativa para desarrollo local: SMTP con Gmail.
# Con Gmail: activa la verificación en 2 pasos y crea una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# Si lo dejas vacío, en desarrollo el código se muestra en la consola.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CLAVE=

# En el servidor publicado pon NODE_ENV=production
# (así nunca se muestran códigos en la consola)
NODE_ENV=development

# IA (Fase 7) — la clave SOLO vive en el backend
OPENAI_API_KEY=
